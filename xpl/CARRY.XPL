<?xml version="1.0" encoding="utf-8"?>
<!-- Date(ymd)/time(hms) 2026/08/18 19:04:55 -->
<Xpl-source>
<HostEnvironment>
<Config>
<FileId>0x697bd4c3</FileId>
<Target>Robox Motion Control</Target>
<XplType>RoboticProgramLanguage</XplType>
</Config>
</HostEnvironment>
<XplEnvironment>
<Title LcId="1033">
<![CDATA[XPL program]]>
</Title>
<Description LcId="1033">
<![CDATA[XPL program edited from teachgun]]>
</Description>
<Version>1.0.0</Version>
<Author>Robox SpA</Author>
<VarDeclarations>
<VarGlobal>
<Var>
<Name>PH</Name>
<Comment>
<![CDATA[准备点]]>
</Comment>
<Type>POINTC</Type>
<InitValue>(383.85,5.71,497.03,95.479750,-88.191791,83.848310,2,0,0,-1)</InitValue>
</Var>
<Var>
<Name>S1</Name>
<Type>POINTC</Type>
<InitValue>(337.34,399.67,155.27,95.196837,-88.178927,84.132582,2,0,0,-1)</InitValue>
</Var>
<Var>
<Name>D1</Name>
<Type>POINTC</Type>
<InitValue>(334.29,-206.81,170.06,95.343383,-88.197350,83.981809,2,0,0,-1)</InitValue>
</Var>
<Var>
<Name>x</Name>
<Type>LREAL</Type>
<InitValue>98.04</InitValue>
</Var>
<Var>
<Name>y</Name>
<Type>LREAL</Type>
<InitValue>-86.57</InitValue>
</Var>
<Var>
<Name>CCD1_execute</Name>
<Type>EPOINTC</Type>
<InitValue>(91.06,341.70,313.38,-174.096470,-88.187902,84.001286,0,0,0,0,0,0,2,0,0,-1)</InitValue>
</Var>
<Var>
<Name>SrcPos</Name>
<Type>POINTC</Type>
<Array>[1..9]</Array>
</Var>
<Var>
<Name>DstPos</Name>
<Type>POINTC</Type>
<Array>[1..9]</Array>
</Var>
<Var>
<Name>i</Name>
<Type>DINT</Type>
</Var>
</VarGlobal>
</VarDeclarations>
<Pous>
<Pou>
<Name>Main</Name>
<Type>Program</Type>
<Body>
<rem>
<text>到达准备点</text>
</rem>
<mjoint>
<target>PH</target>
<speed>v1000</speed>
<zone>fine</zone>
<tool>tool0</tool>
</mjoint>
<rem disable="true">
<text>回到初始物料点S1</text>
</rem>
<mjoint disable="true">
<target>S1</target>
<speed>v500</speed>
<zone>fine</zone>
<tool>tool0</tool>
</mjoint>
<rem>
<text>计算所有物料取放点位</text>
</rem>
<call>
<subroutine>
<name>POINT</name>
<args>
<arg />
</args>
</subroutine>
</call>
<rem>
<text>循环搬运 9 个物料</text>
</rem>
<for>
<var>i</var>
<from>1</from>
<to>9</to>
<pouref>1</pouref>
</for>
<mjoint>
<target>PH</target>
<speed>v500</speed>
<zone>fine</zone>
<tool>tool0</tool>
</mjoint>
<rem>
<text />
</rem>
<rem>
<text />
</rem>
</Body>
<Pou>
<Name>1</Name>
<Body>
<rem>
<text>取料</text>
</rem>
<call>
<subroutine>
<name>STAND</name>
<args>
<arg>SrcPos[i]</arg>
</args>
</subroutine>
</call>
<rem>
<text>拍照定位</text>
</rem>
<call>
<subroutine>
<name>CCD</name>
</subroutine>
</call>
<rem>
<text>放料</text>
</rem>
<call>
<subroutine>
<name>DOWN</name>
<args>
<arg>DstPos[i]</arg>
</args>
</subroutine>
</call>
</Body>
</Pou>
</Pou>
<Pou>
<Name>POINT</Name>
<Type>Subroutine</Type>
<Body>
<set>
<dest>SrcPos[1]</dest>
<expr>S1</expr>
</set>
<set>
<dest>DstPos[1]</dest>
<expr>D1</expr>
</set>
<rem>
<text>取料点点位</text>
</rem>
<set>
<dest>SrcPos[2]</dest>
<expr>OFFSET(S1,x,0,0)</expr>
</set>
<set>
<dest>SrcPos[3]</dest>
<expr>OFFSET(S1,x*2,0,0)</expr>
</set>
<set>
<dest>SrcPos[4]</dest>
<expr>OFFSET(S1,x*2,y,0)</expr>
</set>
<set>
<dest>SrcPos[5]</dest>
<expr>OFFSET(S1,x,y,0)</expr>
</set>
<set>
<dest>SrcPos[6]</dest>
<expr>OFFSET(S1,0,y,0)</expr>
</set>
<set>
<dest>SrcPos[7]</dest>
<expr>OFFSET(S1,0,y*2,0)</expr>
</set>
<set>
<dest>SrcPos[8]</dest>
<expr>OFFSET(S1,x,y*2,0)</expr>
</set>
<set>
<dest>SrcPos[9]</dest>
<expr>OFFSET(S1,x*2,y*2,0)</expr>
</set>
<rem>
<text>放料点点位</text>
</rem>
<set>
<dest>DstPos[2]</dest>
<expr>OFFSET(D1,x,0,0)</expr>
</set>
<set>
<dest>DstPos[3]</dest>
<expr>OFFSET(D1,x*2,0,0)</expr>
</set>
<set>
<dest>DstPos[4]</dest>
<expr>OFFSET(D1,x*2,y,0)</expr>
</set>
<set>
<dest>DstPos[5]</dest>
<expr>OFFSET(D1,x,y,0)</expr>
</set>
<set>
<dest>DstPos[6]</dest>
<expr>OFFSET(D1,0,y,0)</expr>
</set>
<set>
<dest>DstPos[7]</dest>
<expr>OFFSET(D1,0,y*2,0)</expr>
</set>
<set>
<dest>DstPos[8]</dest>
<expr>OFFSET(D1,x,y*2,0)</expr>
</set>
<set>
<dest>DstPos[9]</dest>
<expr>OFFSET(D1,x*2,y*2,0)</expr>
</set>
<rem>
<text />
</rem>
</Body>
</Pou>
<Pou>
<Name>CCD</Name>
<Type>Subroutine</Type>
<Body>
<rem>
<text>过渡点</text>
</rem>
<mjoint>
<target>POINTC(283.82,168.94,432.20,129.944929,-88.187730,84.030010,&quot;CFG2&quot;,0,0,0)</target>
<speed>v1000</speed>
<zone>z30</zone>
<tool>tool0</tool>
</mjoint>
<rem>
<text>拍照点</text>
</rem>
<mjoint>
<target>CCD1_execute</target>
<speed>v500</speed>
<zone>fine</zone>
<tool>tool0</tool>
</mjoint>
<dwell>
<expr>0.5</expr>
</dwell>
<rem>
<text>相机连接</text>
</rem>
<call>
<subroutine>
<name>tcpip.sockopen</name>
<args>
<arg>1</arg>
</args>
</subroutine>
</call>
<dwell>
<expr>0.5</expr>
</dwell>
<rem>
<text>发送拍照</text>
</rem>
<call>
<subroutine>
<name>tcpip.socksend</name>
<args>
<arg>1</arg>
<arg>&quot;1111&quot;</arg>
<arg>true</arg>
</args>
</subroutine>
</call>
<dwell>
<expr>0.5</expr>
</dwell>
<rem>
<text />
</rem>
<rem>
<text>关闭连接</text>
</rem>
<call>
<subroutine>
<name>tcpip.sockclose</name>
<args>
<arg>1</arg>
</args>
</subroutine>
</call>
<rem>
<text>回原</text>
</rem>
<rem>
<text>go_home() ;</text>
</rem>
</Body>
</Pou>
<Pou>
<Name>STAND</Name>
<Type>Subroutine</Type>
<VarDeclarations>
<VarInterface>
<Var>
<Name>st</Name>
<Type>POINTC</Type>
<Attrib>In</Attrib>
</Var>
</VarInterface>
<VarLocal />
</VarDeclarations>
<Body>
<rem>
<text>移动到物料上方100安全位置</text>
</rem>
<mlin>
<target>OFFSET(st,0,0,100)</target>
<speed>v1000</speed>
<zone>fine</zone>
<tool>tool0</tool>
</mlin>
<rem>
<text>直线下落到取料点</text>
</rem>
<mlin>
<target>st</target>
<speed>v500</speed>
<zone>fine</zone>
<tool>tool0</tool>
</mlin>
<rem>
<text>、吸真空</text>
</rem>
<set>
<dest>io.DOut[8]</dest>
<expr>true</expr>
</set>
<dwell>
<expr>0.5</expr>
</dwell>
<set disable="true">
<dest>io.DOut[8]</dest>
<expr>false</expr>
</set>
<dwell disable="true">
<expr>0.5</expr>
</dwell>
<rem disable="true">
<text>吸真空到达</text>
</rem>
<wait disable="true">
<condition>io.DIn[8]</condition>
</wait>
<rem>
<text>回升到安全点</text>
</rem>
<mlin>
<target>OFFSET(st,0,0,100)</target>
<speed>v1000</speed>
<zone>fine</zone>
<tool>tool0</tool>
</mlin>
<rem>
<text />
</rem>
</Body>
</Pou>
<Pou>
<Name>DOWN</Name>
<Type>Subroutine</Type>
<VarDeclarations>
<VarInterface>
<Var>
<Name>dt</Name>
<Type>POINTC</Type>
<Attrib>In</Attrib>
</Var>
</VarInterface>
<VarLocal />
</VarDeclarations>
<Body>
<mlin>
<target>POINTC(337.36,348.68,343.81,138.616894,-88.189452,83.919533,&quot;CFG2&quot;,0,0,-1)</target>
<speed>v1000</speed>
<zone>fine</zone>
<tool>tool0</tool>
</mlin>
<rem>
<text />
</rem>
<rem>
<text>移动到放料点上方100安全位置</text>
</rem>
<mlin>
<target>OFFSET(dt,0,0,100)</target>
<speed>v500</speed>
<zone>fine</zone>
<tool>tool0</tool>
</mlin>
<rem>
<text>直线下落到放料点</text>
</rem>
<mlin>
<target>dt</target>
<speed>v500</speed>
<zone>fine</zone>
<tool>tool0</tool>
</mlin>
<rem>
<text>破真空</text>
</rem>
<set>
<dest>io.DOut[8]</dest>
<expr>false</expr>
</set>
<dwell>
<expr>0.5</expr>
</dwell>
<set>
<dest>io.DOut[9]</dest>
<expr>true</expr>
</set>
<dwell>
<expr>0.5</expr>
</dwell>
<set>
<dest>io.DOut[9]</dest>
<expr>false</expr>
</set>
<dwell>
<expr>0.5</expr>
</dwell>
<rem>
<text>回升到安全点</text>
</rem>
<mlin>
<target>OFFSET(dt,0,0,100)</target>
<speed>v200</speed>
<zone>fine</zone>
<tool>tool0</tool>
</mlin>
<rem>
<text />
</rem>
<rem>
<text />
</rem>
</Body>
</Pou>
</Pous>
</XplEnvironment>
</Xpl-source>